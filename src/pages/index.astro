---
import cities from '../data/cities.json';

// Set PUBLIC_SITE_URL in CF Pages env vars once the domain is confirmed
// e.g. PUBLIC_SITE_URL=https://city.perkd.com.au
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://perkd.com.au').replace(/\/$/, '');

const title = 'Smart Vending Machines Australia | Perkd City Hub';
const description = 'Perkd places smart vending fridges in cafes, offices, gyms, and commercial venues across Brisbane, Gold Coast, Melbourne, and surrounding suburbs. Zero upfront cost. Revenue share model.';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "Perkd",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "description": description,
  "areaServed": cities.map(c => ({ "@type": "City", "name": c.name })),
  "sameAs": [
    "https://www.linkedin.com/company/perkd",
    "https://www.instagram.com/perkdau"
  ]
};
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${siteUrl}/`} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --brand: #1a1a2e; --accent: #e94560; --text: #1f2937; --muted: #6b7280; --surface: #f9fafb; --border: #e5e7eb; --radius: 8px; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--text); line-height: 1.6; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <header style="background:var(--brand);padding:1rem 0;">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;">
      <a href="https://perkd.com.au" style="color:#fff;font-weight:700;font-size:1.25rem;">Perkd</a>
      <a href="https://perkd.com.au/contact" style="color:#fff;font-size:0.9rem;font-weight:600;background:var(--accent);padding:0.4rem 1rem;border-radius:var(--radius);">Get started</a>
    </div>
  </header>

  <!-- HERO -->
  <section style="background:var(--brand);color:#fff;padding:4rem 0 3.5rem;">
    <div class="container">
      <p style="color:var(--accent);font-size:0.85rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;margin-bottom:0.75rem;">Smart Vending Australia</p>
      <h1 style="font-size:clamp(1.75rem,4vw,2.75rem);font-weight:800;margin-bottom:1rem;line-height:1.2;">Smart Vending Machines<br/>Across Australia</h1>
      <p style="color:#d1d5db;max-width:560px;font-size:1.05rem;margin-bottom:2rem;">Perkd places fully managed AI smart vending fridges in cafes, gyms, offices, hospitals, and commercial venues nationwide. Zero upfront cost. Revenue share paid directly to your venue.</p>
      <a href="https://perkd.com.au/contact" style="background:var(--accent);color:#fff;font-weight:700;padding:0.875rem 2rem;border-radius:var(--radius);display:inline-block;font-size:1rem;">Get a free site assessment →</a>
      <p style="margin-top:1.25rem;color:#9ca3af;font-size:0.85rem;">✓ Zero upfront cost &nbsp;·&nbsp; ✓ Fully managed &nbsp;·&nbsp; ✓ Revenue share for venues</p>
    </div>
  </section>

  <!-- STATS BAR -->
  <section style="background:var(--accent);padding:1.25rem 0;">
    <div class="container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;text-align:center;">
      <div><span style="font-size:1.6rem;font-weight:800;color:#fff;">$0</span><br/><span style="color:rgba(255,255,255,0.85);font-size:0.82rem;">Upfront cost</span></div>
      <div><span style="font-size:1.6rem;font-weight:800;color:#fff;">16</span><br/><span style="color:rgba(255,255,255,0.85);font-size:0.82rem;">Cities served</span></div>
      <div><span style="font-size:1.6rem;font-weight:800;color:#fff;">24/7</span><br/><span style="color:rgba(255,255,255,0.85);font-size:0.82rem;">Remote monitoring</span></div>
      <div><span style="font-size:1.6rem;font-weight:800;color:#fff;">&lt;48h</span><br/><span style="color:rgba(255,255,255,0.85);font-size:0.82rem;">Restocking SLA</span></div>
    </div>
  </section>

  <!-- CITY GRID -->
  <section style="padding:3.5rem 0;">
    <div class="container">
      <h2 style="font-size:1.35rem;font-weight:700;margin-bottom:0.5rem;">Select your city or suburb</h2>
      <p style="color:var(--muted);margin-bottom:2rem;">Find smart vending machine placement services in your city — zero upfront cost, fully managed operations.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem;">
        {cities.map((city) => (
          <a href={`/vending-machine-${city.slug}`} style="display:block;border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;background:#fff;transition:box-shadow 0.15s;" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.08)'" onmouseout="this.style.boxShadow='none'">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;">
              <span style="font-weight:700;font-size:1.05rem;">{city.name}</span>
              <span style="font-size:0.75rem;background:var(--surface);padding:0.2rem 0.6rem;border-radius:100px;color:var(--muted);border:1px solid var(--border);">{city.state}</span>
            </div>
            <p style="color:var(--muted);font-size:0.875rem;margin-bottom:0.75rem;">{city.businessTypes.slice(0, 3).join(' · ')}</p>
            <span style="color:var(--accent);font-size:0.875rem;font-weight:600;">View vending options →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section style="padding:4rem 0;background:var(--surface);">
    <div class="container">
      <h2 style="font-size:1.6rem;font-weight:700;margin-bottom:0.5rem;text-align:center;">How Perkd Works for Australian Venues</h2>
      <p style="color:var(--muted);text-align:center;margin-bottom:3rem;max-width:520px;margin-left:auto;margin-right:auto;">We handle everything. You earn a revenue share on every sale — no restocking, no maintenance, no stress.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2rem;">
        <div style="text-align:center;">
          <div style="width:52px;height:52px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:1.3rem;margin:0 auto 1rem;">1</div>
          <h3 style="font-weight:700;margin-bottom:0.5rem;">Free site assessment</h3>
          <p style="color:var(--muted);font-size:0.9rem;">We visit your venue, assess foot traffic and placement, and confirm a revenue share offer. No commitment required.</p>
        </div>
        <div style="text-align:center;">
          <div style="width:52px;height:52px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:1.3rem;margin:0 auto 1rem;">2</div>
          <h3 style="font-weight:700;margin-bottom:0.5rem;">Installation in 1–2 hours</h3>
          <p style="color:var(--muted);font-size:0.9rem;">Our team installs and fully stocks the smart fridge. We handle electrical, connectivity, and product selection for your customer type.</p>
        </div>
        <div style="text-align:center;">
          <div style="width:52px;height:52px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:1.3rem;margin:0 auto 1rem;">3</div>
          <h3 style="font-weight:700;margin-bottom:0.5rem;">Earn while we manage</h3>
          <p style="color:var(--muted);font-size:0.9rem;">You receive a revenue share payment monthly. We monitor stock 24/7, restock within 48 hours, and handle all maintenance remotely.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY SMART VENDING -->
  <section style="padding:4rem 0;">
    <div class="container">
      <h2 style="font-size:1.6rem;font-weight:700;margin-bottom:0.5rem;">Why Australian Businesses Choose Smart Vending</h2>
      <p style="color:var(--muted);margin-bottom:2.5rem;max-width:600px;">Traditional vending machines require manual restocking and constant maintenance. Perkd smart fridges use computer vision and IoT sensors to manage themselves — you simply host the machine and earn.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;">
        {[
          { title: 'AI-powered inventory', body: 'Computer vision tracks every item picked. Stock data is updated in real time — no manual counts, no stockouts.' },
          { title: 'Cashless only', body: 'Tap-and-go card, Apple Pay, and Google Pay. No cash handling, no coin jams, no theft risk.' },
          { title: 'Product tailored to your venue', body: 'Gyms get protein. Offices get coffee and fresh food. Hospitals get health-conscious options. We adapt monthly.' },
          { title: 'Zero maintenance burden', body: 'All cleaning, repairs, restocking, and compliance are handled by Perkd. Your staff never touch the machine.' },
        ].map(f => (
          <div style="border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;background:#fff;">
            <h3 style="font-weight:700;margin-bottom:0.5rem;font-size:1rem;">{f.title}</h3>
            <p style="color:var(--muted);font-size:0.875rem;">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding:4rem 0;background:var(--surface);">
    <div class="container" style="max-width:740px;">
      <h2 style="font-size:1.6rem;font-weight:700;margin-bottom:2rem;">Frequently Asked Questions</h2>
      <div style="display:flex;flex-direction:column;gap:1.25rem;">
        {[
          { q: 'Is there any upfront cost to host a Perkd smart vending machine?', a: 'No. Perkd covers 100% of the machine cost, installation, product sourcing, and ongoing maintenance. We operate on a revenue share model — you earn a percentage of every sale at your venue with zero capital outlay.' },
          { q: 'What types of Australian venues are suitable for smart vending?', a: 'Any commercial venue with 30 or more daily visitors can host a Perkd smart fridge. Common placements include gyms, cafes, office buildings, co-working spaces, universities, hospitals, hotels, and shopping centres. We operate across 16 cities in QLD, VIC, NSW, WA, SA, and ACT.' },
          { q: 'How does Perkd differ from a traditional vending machine?', a: 'Traditional vending machines require manual restocking by the owner and use unreliable mechanical dispensing. Perkd smart fridges use computer vision to track inventory in real time, support cashless payments only, and are restocked by our team within 48 hours — without any input from your venue.' },
          { q: 'How long does installation take?', a: 'Installation typically takes 1–2 hours. We handle all electrical and connectivity requirements. Your venue is up and earning within one week of signing.' },
          { q: 'Which Australian cities does Perkd currently serve?', a: `Perkd currently operates in ${cities.slice(0,8).map(c=>c.name).join(', ')}, and more. We are expanding continuously — contact us if your city is not listed.` },
        ].map(faq => (
          <details style="border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;background:#fff;">
            <summary style="font-weight:600;cursor:pointer;">{faq.q}</summary>
            <p style="margin-top:0.75rem;color:var(--muted);">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--brand);color:#fff;padding:4rem 0;text-align:center;">
    <div class="container">
      <h2 style="font-size:1.75rem;font-weight:800;margin-bottom:0.75rem;">Ready to host a smart vending machine?</h2>
      <p style="color:#d1d5db;margin-bottom:1.5rem;max-width:480px;margin-left:auto;margin-right:auto;">Select your city above or get in touch. We'll assess your venue and make an offer — no obligation, no hard sell.</p>
      <a href="https://perkd.com.au/contact" style="background:var(--accent);color:#fff;font-weight:700;padding:1rem 2.5rem;border-radius:var(--radius);font-size:1.1rem;display:inline-block;">Get a free site assessment →</a>
      <p style="margin-top:1.5rem;color:#9ca3af;font-size:0.8rem;">We're expanding across Australia. Don't see your city? <a href="https://perkd.com.au/contact" style="color:var(--accent);">Register your interest.</a></p>
    </div>
  </section>

  <footer style="background:#111827;color:#6b7280;padding:1.75rem 0;text-align:center;font-size:0.85rem;">
    <p>© 2024 Perkd Pty Ltd · ABN 00 000 000 000 · <a href="https://perkd.com.au/privacy" style="color:#4b5563;">Privacy Policy</a> · <a href="https://perkd.com.au/terms" style="color:#4b5563;">Terms</a></p>
    <p style="margin-top:0.5rem;color:#374151;font-size:0.8rem;">Smart vending machines Australia · Brisbane · Melbourne · Sydney · Perth · Adelaide · Canberra</p>
  </footer>
</body>
</html>

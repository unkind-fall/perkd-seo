---
import cities from '../data/cities.json';

// Set PUBLIC_SITE_URL in CF Pages env vars once the domain is confirmed
// e.g. PUBLIC_SITE_URL=https://city.perkd.com.au
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://perkd.com.au').replace(/\/$/, '');

const title = 'Smart Vending Machines Australia | Perkd City Hub';
const description = 'Perkd places smart vending fridges in cafes, offices, gyms, and commercial venues across Brisbane, Gold Coast, Melbourne, and surrounding suburbs. Zero upfront cost. Revenue share model.';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "Perkd",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "description": description,
  "areaServed": cities.map(c => ({ "@type": "City", "name": c.name })),
  "sameAs": [
    "https://www.linkedin.com/company/perkd",
    "https://www.instagram.com/perkdau"
  ]
};
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${siteUrl}/`} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --brand: #1a1a2e; --accent: #e94560; --text: #1f2937; --muted: #6b7280; --surface: #f9fafb; --border: #e5e7eb; --radius: 8px; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--text); line-height: 1.6; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <header style="background:var(--brand);padding:1rem 0;">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;">
      <a href="https://perkd.com.au" style="color:#fff;font-weight:700;font-size:1.25rem;">Perkd</a>
      <a href="https://perkd.com.au/contact" style="color:#fff;font-size:0.9rem;font-weight:600;background:var(--accent);padding:0.4rem 1rem;border-radius:var(--radius);">Get started</a>
    </div>
  </header>

  <section style="background:var(--brand);color:#fff;padding:3.5rem 0 3rem;">
    <div class="container">
      <h1 style="font-size:clamp(1.75rem,4vw,2.75rem);font-weight:800;margin-bottom:0.75rem;">Smart Vending Machines Across Australia</h1>
      <p style="color:#d1d5db;max-width:560px;font-size:1.05rem;">Perkd places fully managed smart vending fridges in cafes, gyms, offices, and commercial venues. Zero upfront cost. Revenue share for your venue.</p>
    </div>
  </section>

  <section style="padding:3.5rem 0;">
    <div class="container">
      <h2 style="font-size:1.35rem;font-weight:700;margin-bottom:0.5rem;">Select your city or suburb</h2>
      <p style="color:var(--muted);margin-bottom:2rem;">Find out how Perkd can generate passive revenue for your venue.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem;">
        {cities.map((city) => (
          <a href={`/vending-machine-${city.slug}`} style="display:block;border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;background:#fff;transition:box-shadow 0.15s;" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.08)'" onmouseout="this.style.boxShadow='none'">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;">
              <span style="font-weight:700;font-size:1.05rem;">{city.name}</span>
              <span style="font-size:0.75rem;background:var(--surface);padding:0.2rem 0.6rem;border-radius:100px;color:var(--muted);border:1px solid var(--border);">{city.state}</span>
            </div>
            <p style="color:var(--muted);font-size:0.875rem;margin-bottom:0.75rem;">{city.businessTypes.slice(0, 3).join(' · ')}</p>
            <span style="color:var(--accent);font-size:0.875rem;font-weight:600;">View vending options →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--brand);color:#fff;padding:3.5rem 0;text-align:center;">
    <div class="container">
      <h2 style="font-size:1.75rem;font-weight:800;margin-bottom:0.75rem;">Don't see your city?</h2>
      <p style="color:#d1d5db;margin-bottom:1.5rem;max-width:440px;margin-left:auto;margin-right:auto;">We're expanding across Australia. Get in touch and we'll let you know when Perkd reaches your area.</p>
      <a href="https://perkd.com.au/contact" style="background:var(--accent);color:#fff;font-weight:700;padding:0.875rem 2rem;border-radius:var(--radius);display:inline-block;">Register your interest →</a>
    </div>
  </section>

  <footer style="background:#111827;color:#6b7280;padding:1.5rem 0;text-align:center;font-size:0.85rem;">
    <p>© 2024 Perkd Pty Ltd · Smart vending machines across Australia</p>
  </footer>
</body>
</html>
